{
  "name": "papyrus",
  "version": "1.0.0",
  "description": "Papyrus —— 纯 TypeScript 个人书籍管理系统（豆瓣数据源 + SQLite 本地存储）",
  "type": "module",
  "main": "dist/server/index.js",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "esbuild src/frontend/main.ts --bundle --minify --outfile=public/app.js",
    "build": "npm run build:client && npm run build:server",
    "start": "npm run build && node dist/server/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.client.json"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "cheerio": "^1.0.0",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "esbuild": "^0.24.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
